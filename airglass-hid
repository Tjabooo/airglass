# --------------------------------------------------------------------------- config
def load_config():
    cfg = {
        "CONTROL": "yes",
        "RELEASE_KEY": "KEY_RIGHTCTRL",
        "SENSITIVITY": "1.0",
        "SCROLL_INVERT": "no",
        "REPORT_INTERVAL_MS": "8",
        "MIRROR_CLASS": "^(uxplay|airglass)$",
        "NOTIFY": "yes",
    }
    path = os.environ.get("AIRGLASS_CONFIG") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "airglass", "config")
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.split("#", 1)[0].strip().strip('"')
                cfg[k.strip()] = v
    except FileNotFoundError:
        pass
    return cfg


def yes(v):
    return str(v).lower() in ("yes", "true", "on", "1")


CFG = load_config()


def notify(title, body="", urgency="normal"):
    if not yes(CFG["NOTIFY"]):
        return
    try:
        proc = subprocess.Popen(["notify-send", "-a", "airglass", "-u", urgency, "-i", "input-mouse",
                                 "-h", "string:x-dunst-stack-tag:airglass-hid", title, body],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.child_watch_add(GLib.PRIORITY_LOW, proc.pid, lambda *_: proc.poll())
    except OSError:
        pass


